# Required: root of your Obsidian vault (the folder that contains 30-Recursos/).
YT_NOTA_VAULT=/path/to/your/Obsidian

# Optional: legacy processados.json read by `yt-nota --registry backfill`.
# Default: <YT_NOTA_VAULT>/Claude/automacoes/curadoria-incremental/data/processados.json
# YT_NOTA_PROCESSADOS=/path/to/processados.json

# Optional: Python file exposing gate_text(text) -> {"ok", "summary", "findings"}.
# When set, --finalize logs its result per note in data/finalize-log.jsonl. Never blocks.
# YT_NOTA_WRITING_GATE=/path/to/writing_gate.py
